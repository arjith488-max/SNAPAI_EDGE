# SnapAI Edge - Environment Variables Configuration
# Copy this file to .env and configure your local settings
# NEVER commit your .env file with real credentials to version control

# ─── Multi-Model AI Providers ──────────────────────────────
AI_DEFAULT_PROVIDER=auto
AI_DEFAULT_MODE=hybrid
DEFAULT_AI_PROVIDER=auto

# ─── Google Gemini Provider ────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ─── OpenAI Provider ───────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Ollama (Local AI Provider) ────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Jina AI (Optional Cloud RAG Embeddings) ───────────────
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v3
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual

# ─── Backend Server ────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-random-secret-key

# ─── Frontend Configuration ────────────────────────────────
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_APP_NAME=SnapAI Edge

# ─── Database & Storage ────────────────────────────────────
DATABASE_URL=sqlite:///./snapai.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ─── Privacy Guard & Routing Defaults ──────────────────────
# Options: auto | local_first | cloud_first | hybrid | offline_only
DEFAULT_PRIVACY_MODE=local_first
TELEMETRY_ENABLED=false
ENABLE_CLOUD_AI=true

# ─── Feature Flags ─────────────────────────────────────────
ENABLE_CAMERA=true
ENABLE_VOICE=true
ENABLE_WEB_SEARCH=false
